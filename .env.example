# ==============================================================================
# Yaqoob Enterprises Manager - Desktop POS & ERP Environment Configuration
# ==============================================================================

# Supabase Cloud Project Configuration (Optional - for Multi-Device Cloud Sync)
# The application runs fully offline with local SQLite if these are omitted.
# Obtain these from your Supabase Dashboard: Project Settings > API
VITE_SUPABASE_URL="https://your-tenant-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Legacy anon keys are still supported for older projects:
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# CRITICAL SECURITY RULE:
# NEVER put SUPABASE_SERVICE_ROLE_KEY here or anywhere in client-side code!
# The client desktop app operates strictly under Row-Level Security (RLS) policies
# using the public anonymous key (ANON_KEY) and authenticated user JWT sessions.

# Local Desktop Server Port (Optional override, defaults to 3000 in dev)
PORT=3000

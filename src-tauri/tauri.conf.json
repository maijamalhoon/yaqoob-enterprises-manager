{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Yaqoob Enterprises Manager",
  "version": "1.0.0",
  "identifier": "com.yaqoobenterprises.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yaqoob Enterprises Manager",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Yaqoob Enterprises",
    "copyright": "Copyright © 2026 Yaqoob Enterprises. All rights reserved.",
    "shortDescription": "Enterprise POS & Shop Management System",
    "longDescription": "Offline-first Windows desktop business application for Yaqoob Enterprises. Comprehensive management of printing, photocopying, stationery inventory, expenses, split payments, accounts, daily closing, and P&L reporting.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
